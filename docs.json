{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "G4 OS",
  "colors": {
    "primary": "#B9915B",
    "light": "#B9915B",
    "dark": "#D1BEA4"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.png",
    "dark": "/logo/dark.png"
  },
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Introdução",
          "href": "/",
          "icon": "house"
        },
        {
          "anchor": "Casos de uso",
          "href": "/use-cases",
          "icon": "flask"
        },
        {
          "anchor": "Primeira tarefa",
          "href": "/getting-started/quickstart",
          "icon": "rocket"
        },
        {
          "anchor": "Suporte",
          "href": "/support",
          "icon": "headset"
        }
      ]
    },
    "languages": [
      {
        "language": "pt-BR",
        "default": true,
        "tabs": [
          {
            "tab": "Guia do produto",
            "groups": [
              {
                "group": "Comece aqui",
                "pages": [
                  "index",
                  "getting-started/quickstart",
                  "getting-started/create-workspace",
                  "getting-started/interface"
                ]
              },
              {
                "group": "Organize seu trabalho",
                "pages": [
                  "product/workspaces",
                  "product/projects",
                  "support/projects",
                  "product/sessions",
                  "support/labels"
                ]
              },
              {
                "group": "Crie e revise entregas",
                "pages": [
                  "product/outputs",
                  "product/workbooks",
                  "product/slides",
                  "product/sites",
                  "support/apps",
                  "support/dashboards"
                ]
              },
              {
                "group": "Conecte suas ferramentas",
                "pages": [
                  "product/connections/index",
                  "support/sources",
                  "product/connections/managed-connections",
                  "product/connections/managed-agents",
                  "product/integrations",
                  "support/browser",
                  "support/whatsapp-browser",
                  "support/partners"
                ]
              },
              {
                "group": "Reutilize e automatize",
                "pages": [
                  "support/tools",
                  "product/agents",
                  "support/agents",
                  "support/skills",
                  "support/workflows",
                  "support/marketplace",
                  "product/automation",
                  "support/automation"
                ]
              },
              {
                "group": "Voz e reuniões",
                "pages": [
                  "product/voice-input",
                  "support/desk",
                  "support/meeting-recording"
                ]
              },
              {
                "group": "Conhecimento e empresa",
                "pages": [
                  "support/shared-brain",
                  "support/company-context",
                  "support/context",
                  "support/empresa",
                  "support/user-management-api"
                ]
              },
              {
                "group": "Compartilhe e continue",
                "pages": [
                  "support/sharing",
                  "support/collaborative-session",
                  "support/remote-control",
                  "support/telegram-messaging",
                  "support/cloud-sync"
                ]
              },
              {
                "group": "Configurações e ajuda",
                "pages": [
                  "support/index",
                  "support/app-settings",
                  "support/ai",
                  "support/appearance",
                  "support/input",
                  "support/workspace",
                  "support/preferences",
                  "support/permissions",
                  "support/shortcuts",
                  "support/usage",
                  "support/billing-subscriptions",
                  "support/repair-mode",
                  "product/security",
                  "product/privacy-and-data"
                ]
              }
            ]
          },
          {
            "tab": "Casos de uso",
            "groups": [
              {
                "group": "Escolha uma tarefa",
                "pages": [
                  "use-cases/index"
                ]
              },
              {
                "group": "Dia a dia",
                "pages": [
                  "use-cases/rotina/reunioes",
                  "use-cases/rotina/email",
                  "use-cases/rotina/acompanhamento",
                  "use-cases/rotina/documentos",
                  "use-cases/rotina/pesquisa"
                ]
              },
              {
                "group": "Marketing e vendas",
                "pages": [
                  "use-cases/marketing-vendas/cohort-receita",
                  "use-cases/marketing-vendas/funil-marketing",
                  "use-cases/marketing-vendas/churn-retencao",
                  "use-cases/marketing-vendas/performance-comercial"
                ]
              },
              {
                "group": "Processos e entregas",
                "pages": [
                  "use-cases/operacoes/apqc-otimizacao-processos",
                  "use-cases/design/design-slides",
                  "use-cases/seguranca/seguranca-lovable"
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Primeira tarefa",
        "href": "/getting-started/quickstart"
      },
      {
        "label": "Suporte",
        "href": "/support"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Acessar G4 OS",
      "href": "https://g4oscloud.com/download-public"
    }
  },
  "redirects": [
    {
      "source": "/product/connection-types",
      "destination": "/product/connections"
    },
    {
      "source": "/quickstart",
      "destination": "/getting-started/quickstart"
    },
    {
      "source": "/development",
      "destination": "/getting-started/quickstart"
    },
    {
      "source": "/essentials/settings",
      "destination": "/support/app-settings"
    },
    {
      "source": "/essentials/navigation",
      "destination": "/support"
    },
    {
      "source": "/essentials/:slug*",
      "destination": "/support"
    },
    {
      "source": "/ai-tools/:slug*",
      "destination": "/support/ai"
    },
    {
      "source": "/api-reference/introduction",
      "destination": "/support"
    },
    {
      "source": "/support/tags",
      "destination": "/support/labels"
    }
  ],
  "footer": {
    "socials": {
      "github": "https://github.com/Gestao-Quatro-Ponto-Zero"
    }
  },
  "description": "Guias práticos do G4 OS para pesquisar, escrever, analisar, organizar e automatizar o trabalho."
}
